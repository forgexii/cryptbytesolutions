# ========================================================
# CRYPTBYTE SOLUTIONS - Environment Template (.env.example)
# Duplicate this file as .env and fill in the values.
# ========================================================

# --- CORE DJANGO CONFIGURATION ---
SECRET_KEY=replace-with-a-random-50-character-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- DATABASE CONFIGURATION ---
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- EMAIL CONFIGURATION ---
EMAIL_BACKEND_TYPE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cryptbyte Solutions <hello@cryptbytesolutions.com>

# --- PRODUCTION SECURITY TOGGLES (Set to True in HTTPS production) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

